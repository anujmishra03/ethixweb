# ==============================================================================
# Ethixweb India — Environment Variables Template
# ==============================================================================

# --- Backend Server Configuration (server/.env) ---
# NEVER expose the service role key or server credentials to the browser bundle!
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.vercel.app
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_secret
ADMIN_EMAIL=admin@ethixweb.com

# --- Frontend Client Configuration (client/.env) ---
# Client-side values are embedded in the browser; protected by Postgres Row Level Security (RLS).
VITE_API_URL=/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key
